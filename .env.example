# Deutsche Post Internetmarke API
DP_API_KEY=
DP_API_SECRET=
DP_PORTOKASSE_USER=
DP_PORTOKASSE_PASS=

# Label defaults (pageFormatId 176 = A5 single label)
DP_DEFAULT_PRODUCT=1
DP_PAGE_FORMAT_ID=176

# Default sender address (country as ISO 3166-1 alpha-3)
DP_SENDER_NAME=
DP_SENDER_COMPANY=
DP_SENDER_STREET=
DP_SENDER_ZIP=
DP_SENDER_CITY=
DP_SENDER_COUNTRY=DEU

# PrintNode
PRINTNODE_API_KEY=
PRINTNODE_DEFAULT_PRINTER=

PORT=3000
